# These values are embedded in the app and must contain NO secrets.
# Hosted Render API for device checks. A fork should use its own Render HTTPS URL.
EXPO_PUBLIC_API_URL=https://solace-ai-n8s4.onrender.com
# Public Web OAuth client ID. Must match GOOGLE_WEB_CLIENT_ID on the API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Public iOS OAuth client ID for bundle com.humanityfounders.solaceai.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Public reversed iOS OAuth client ID used as the Google callback URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
