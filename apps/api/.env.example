# Copy to apps/api/.env. Never commit real credentials.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to 1 on Render (one reverse proxy); keep 0 for local development.
TRUST_PROXY=0
# Runtime connection: Neon Connect dialog with connection pooling ON.
DATABASE_URL=
# Migration connection: same branch, connection pooling OFF.
DATABASE_URL_DIRECT=
# Tests start disposable PostgreSQL automatically; no Neon test URL is needed.
# Only needed for browser clients. Native Android requests have no Origin header.
CORS_ORIGINS=
# Required for Google authentication. Use different random secrets, 32+ characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_WEB_CLIENT_ID=
# Required for chat; keys stay on the server.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Groq: enable Zero Data Retention in organization Settings > Data Controls.
