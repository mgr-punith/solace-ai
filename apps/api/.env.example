# Copy to apps/api/.env. Never commit real credentials.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Runtime connection: Neon Connect dialog with connection pooling ON.
DATABASE_URL=
# Migration connection: same branch, connection pooling OFF.
DATABASE_URL_DIRECT=
# Separate test branch: use its DIRECT connection, pooling OFF.
DATABASE_URL_TEST=
# Only needed for browser clients. Native Android requests have no Origin header.
CORS_ORIGINS=
# Reserved for Phase 1. Not required to boot Phase 0.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_WEB_CLIENT_ID=
# Reserved for Phase 4. Not required to boot Phase 0.
LLM_PROVIDER=vyceai
LLM_BASE_URL=https://vyceai.com/v1
LLM_API_KEY=
LLM_MODEL=
