{
  "expo": {
    "name": "Solace",
    "slug": "solace",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "solace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.puneet.solace"
    },
    "android": {
      "package": "com.puneet.solace",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF3F2",
          "dark": {
            "backgroundColor": "#0F1A24"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "496ee977-fafc-40cd-b844-9315f4ee7b6d"
      }
    },
    "owner": "puneet017"
  }
}
