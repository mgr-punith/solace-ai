{
  "expo": {
    "name": "Solace",
    "slug": "solace",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "solace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.puneet.solace",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.puneet.solace",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/sol-icon-foreground.png",
        "backgroundColor": "#9CC9BF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/sol-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EEF3F2",
          "dark": {
            "image": "./assets/sol-mark.png",
            "backgroundColor": "#0F1A24"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "496ee977-fafc-40cd-b844-9315f4ee7b6d"
      }
    },
    "owner": "puneet017",
    "icon": "./assets/sol-icon.png"
  }
}
